#!/usr/bin/env bash
set -euo pipefail

WORKSPACE_DIR="./workspace"
ARCHIVE_DIR="./archive"

usage() {
  cat <<'EOF'
Usage:
  workspace                  Choose an action interactively (add or archive)
  workspace add [name]       Create a folder under ./workspace
  workspace archive [name]   Move a folder from ./workspace to ./archive
  workspace help             Show this help message
EOF
}

die() {
  printf 'Error: %s\n' "$1" >&2
  exit 1
}

require_dirs() {
  [[ -d "$WORKSPACE_DIR" ]] || die "'$WORKSPACE_DIR' does not exist in $(pwd)."
  [[ -d "$ARCHIVE_DIR" ]] || die "'$ARCHIVE_DIR' does not exist in $(pwd)."
}

validate_name() {
  local name="$1"
  [[ -n "$name" ]] || die "Workspace name cannot be empty."
  [[ "$name" != "." && "$name" != ".." ]] || die "Invalid workspace name: '$name'."
  [[ "$name" != *"/"* && "$name" != *".."* ]] || die "Workspace name cannot contain '/' or '..'."
}

pick_option() {
  local prompt="$1"
  shift
  local options=("$@")
  if command -v fzf >/dev/null 2>&1 && [[ -t 0 && -t 1 ]]; then
    printf '%s\n' "${options[@]}" | fzf --prompt="$prompt " --height=~10 --layout=reverse --border=top
  else
    PS3="$prompt "
    local choice
    select choice in "${options[@]}"; do
      if [[ -n "${choice:-}" ]]; then
        printf '%s\n' "$choice"
        break
      fi
    done
  fi
}

cmd_add() {
  require_dirs
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    printf 'Workspace name: ' >&2
    IFS= read -r name
  fi
  validate_name "$name"
  local target="$WORKSPACE_DIR/$name"
  [[ ! -e "$target" ]] || die "Workspace '$name' already exists at $target."
  mkdir "$target"
  printf 'Created %s\n' "$target"
}

cmd_archive() {
  require_dirs
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    local dirs=()
    while IFS= read -r dir; do
      [[ -n "$dir" ]] && dirs+=("$dir")
    done < <(find "$WORKSPACE_DIR" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | sort)

    [[ ${#dirs[@]} -gt 0 ]] || die "No workspaces found in $WORKSPACE_DIR."
    name="$(pick_option "Archive workspace:" "${dirs[@]}")" || exit 1
  fi
  validate_name "$name"
  local src="$WORKSPACE_DIR/$name"
  [[ -d "$src" ]] || die "Workspace '$name' does not exist in $WORKSPACE_DIR."

  local dest="$ARCHIVE_DIR/$name"
  if [[ -e "$dest" ]]; then
    local ts
    ts="$(date +%Y%m%d-%H%M%S)"
    dest="$ARCHIVE_DIR/${name}-${ts}"
  fi

  mv "$src" "$dest"
  printf 'Archived %s -> %s\n' "$src" "$dest"
}

main() {
  local subcmd="${1:-}"
  if [[ "$subcmd" == "-h" || "$subcmd" == "--help" || "$subcmd" == "help" ]]; then
    usage
    exit 0
  fi

  require_dirs

  if [[ -z "$subcmd" ]]; then
    subcmd="$(pick_option "Action:" "add" "archive")" || exit 1
  else
    shift
  fi

  case "$subcmd" in
    add)
      cmd_add "${1:-}"
      ;;
    archive)
      cmd_archive "${1:-}"
      ;;
    *)
      die "Unknown command: '$subcmd'. Run 'workspace help' for usage."
      ;;
  esac
}

main "$@"
